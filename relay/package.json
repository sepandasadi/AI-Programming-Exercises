{
  "name": "relay",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && vitest run scripts",
    "dev": "pnpm --filter @relay/api dev",
    "spec:check": "tsx scripts/check-spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review:flags": "bash scripts/review-flags.sh",
    "mutate": "pnpm --filter @relay/core mutate",
    "agents:check": "tsx scripts/check-agent-config.ts"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
