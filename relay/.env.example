# Copy to .env and fill in. Never commit .env.
PORT=3000
# Folder of Markdown docs to search, loaded once at startup.
# Relative paths resolve against the directory the API starts in
# (apps/api for `pnpm dev`). Leave unset to use fixtures/team-docs.
# RELAY_DOCS_DIR=../../fixtures/team-docs
# Team holidays the respond-by business clock skips: comma-separated
# YYYY-MM-DD dates (whole UTC days). An invalid date stops the API at
# startup. Leave unset for no holidays.
# RELAY_HOLIDAYS=2026-12-24,2026-12-25,2027-01-01
