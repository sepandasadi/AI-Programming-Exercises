index 0000000..5ad02dd
--- /dev/null
+++ b/relay/packages/core/src/sla.test.ts
@@ -0,0 +1,52 @@
+// spec: sla-table
+import { describe, expect, it } from "vitest";
+import { addBusinessTime } from "./business-time.js";
+import { slaTable } from "./sla.js";
+import { type Priority, triageIssue } from "./triage.js";
+
+const HOUR = 60 * 60 * 1000;
+
+describe("slaTable", () => {
+  it("AC-2: P0 1h calendar, P1 4h, P2 16h, P3 40h business", () => {
+    expect(slaTable()).toMatchObject([
+      { priority: "P0", hours: 1 },
+      { priority: "P1", hours: 4 },
+      { priority: "P2", hours: 16 },
+      { priority: "P3", hours: 40 },
+    ]);
+  });
+
+  it("AC-3: triage's respond-by matches the table, from Monday 09:00", () => {
+    // 2026-11-23 is a Monday.
+    const createdAt = new Date("2026-11-23T09:00:00Z");
+    const expected: Record<Priority, string> = {
+      P0: "2026-11-23T10:00:00.000Z",
+      P1: "2026-11-23T13:00:00.000Z",
+      P2: "2026-11-24T17:00:00.000Z",
+      P3: "2026-11-27T17:00:00.000Z",
+    };
+    // P3 runs into the next week; triage.test.ts covers it.
+    for (const {
+      priority,
+      hours,
+      clock,
+    } of slaTable().slice(0, 3)) {
+      const n = priority.slice(1);
+      const { respondBy } = triageIssue({
+        number: 1,
+        title: "x",
+        body: null,
+        labels: [`priority:p${n}`],
+        createdAt,
+      });
+      const fromTable =
+        clock === "calendar"
+          ? new Date(createdAt.getTime() + hours * HOUR)
+          : addBusinessTime(createdAt, hours * HOUR);
+      expect(respondBy.toISOString()).toBe(
+        expected[priority],
+      );
+      expect(respondBy).toEqual(fromTable);
+    }
+  });
+});
diff --git a/relay/packages/core/src/sla.ts b/relay/packages/core/src/sla.ts
