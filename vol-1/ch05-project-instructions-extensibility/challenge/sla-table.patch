--- /dev/null
+++ b/relay/packages/core/src/sla.ts
@@ -0,0 +1,17 @@
+import type { Priority } from "./triage.js";
+
+export type SlaEntry = {
+  priority: Priority;
+  hours: number;
+  clock: "calendar" | "business";
+};
+
+/** Respond-by allowance per priority, most urgent first. */
+export function slaTable(): SlaEntry[] {
+  return [
+    { priority: "P0", hours: 1, clock: "calendar" },
+    { priority: "P1", hours: 4, clock: "business" },
+    { priority: "P2", hours: 16, clock: "business" },
+    { priority: "P3", hours: 40, clock: "calendar" },
+  ];
+}
